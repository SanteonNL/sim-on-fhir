  ] ;
  fhir:Patient.identifier [
     fhir:index -1 ;
     fhir:Identifier.system [ fhir:value "https://ig.santeon.nl/fhir/NamingSystem/patient-id" ] ;
     fhir:Identifier.value [ fhir:value "HASH-7F2A91C4" ]
  ] .

