# - resource -------------------------------------------------------------------

<https://ig.santeon.nl/sim-on-fhir/Parameters/ibd-dataset-export> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ibd-dataset-export"] ;
  fhir:Parameters.parameter [
     fhir:index 0 ;
     fhir:Parameters.parameter.name [ fhir:value "_type" ] ;
     fhir:Parameters.parameter.valueString [ fhir:value "Procedure,Observation,Patient" ]
  ], [
     fhir:index 1 ;
     fhir:Parameters.parameter.name [ fhir:value "_typeFilter" ] ;
     fhir:Parameters.parameter.valueString [ fhir:value "Procedure?code:in=https://ig.santeon.nl/sim-on-fhir/ValueSet/local-verrichting-codes-nza&date=ge2018-01-01" ]
  ], [
     fhir:index 2 ;
     fhir:Parameters.parameter.name [ fhir:value "_typeFilter" ] ;
     fhir:Parameters.parameter.valueString [ fhir:value "Observation?code=http://loinc.org|38445-3,http://snomed.info/sct|228273003&date=ge2018-01-01" ]
  ], [
     fhir:index 3 ;
     fhir:Parameters.parameter.name [ fhir:value "_typeFilter" ] ;
     fhir:Parameters.parameter.valueString [ fhir:value "Patient?gender=male,female" ]
  ], [
     fhir:index 4 ;
     fhir:Parameters.parameter.name [ fhir:value "_elements" ] ;
     fhir:Parameters.parameter.valueString [ fhir:value "Procedure.code,Procedure.performed[x],Procedure.subject,Observation.code,Observation.value[x],Observation.effective[x],Observation.subject,Patient.gender,Patient.birthDate" ]
  ] .

